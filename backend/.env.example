# ── LLM (OpenAI) ────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Vector store (ChromaDB in Docker) ──────────────────────────
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=sales_agent

# ── Free local embeddings (Xenova model from Hugging Face) ─────
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# ── RAG tuning ─────────────────────────────────────────────────
TOP_K=6
RELEVANCE_THRESHOLD=0.62
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ── Server ──────────────────────────────────────────────────────
PORT=3001
