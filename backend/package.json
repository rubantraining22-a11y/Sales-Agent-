    "@langchain/openai": "^1.5.6",
    "@langchain/textsplitters": "^1.0.1",
    "cheerio": "^1.2.0",
    "chromadb": "^1.9.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "langchain": "^1.5.5",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pdf-parse": "1.1.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^7.0.0"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "0.33.5"
