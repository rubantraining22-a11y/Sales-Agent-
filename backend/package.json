{
  "name": "sales-agent-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm install && npm install --prefix ../frontend && npm run build --prefix ../frontend",
